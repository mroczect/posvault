[package]
name = "posvault_store"
version = "0.1.0"
edition = "2024"
description = "Event store implementation backed by libvctrl"
license = "MIT"
repository = "https://github.com/mroczect/posvault"

[dependencies]
posvault_handler = { path = "../posvault_handler", version = "0.1.0" }
libvctrl = "0.5"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
chrono = { version = "0.4", default-features = false, features = ["clock", "serde"] }
hex = "0.4"
sha2 = "0.11"
uuid = { version = "1", features = ["v4"] }
zeroize = { version = "1.9", features = ["zeroize_derive"] }
thiserror = "2.0"

[dev-dependencies]
tempfile = "3"
